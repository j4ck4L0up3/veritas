{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "veritas config",
  "type": "object",
  "required": ["host", "port", "upload_ttl", "locations"],
  "additionalProperties": false,
  "$defs": {
    "path": { "type": "string", "minLength": 1 }
  },
  "properties": {
    "host": {
      "description": "Listen address as a string, formatted as IPv4 | IPv6",
      "type": "string",
      "anyOf": [{ "format": "ipv4" }, { "format": "ipv6" }]
    },
    "port": {
      "description": "Listen port, as integer, e.g. 9001",
      "type": "integer",
      "minimum": 1,
      "maximum": 49151
    },
    "upload_ttl": {
      "description": "Upload lifetime in seconds",
      "type": "integer",
      "minimum": 1
    },
    "log_level": {
      "description": "Level for logs at locations.logs, e.g. debug | info | warn | error | fatal",
      "type": "string",
      "oneOf": [
        { "const": "debug" },
        { "const": "info" },
        { "const": "warn" },
        { "const": "error" },
        { "const": "fatal" }
      ]
    },
    "log_format": {
      "description": "Format for logs at locations.logs, e.g. text | json",
      "type": "string",
      "oneOf": [{ "const": "text" }, { "const": "json" }]
    },
    "locations": {
      "type": "object",
      "required": ["db", "bin", "env", "logs", "blobs", "uploads", "service"],
      "additionalProperties": false,
      "properties": {
        "db": {
          "description": "Database file location",
          "$ref": "#/$defs/path"
        },
        "bin": {
          "description": "Binary executable location",
          "$ref": "#/$defs/path"
        },
        "logs": {
          "description": "Log file location, null = stdout",
          "anyOf": [{ "$ref": "#/$defs/path" }, { "type": "null" }]
        },
        "blobs": {
          "description": "Image blobs file location",
          "$ref": "#/$defs/path"
        },
        "uploads": {
          "description": "Pending upload file location",
          "$ref": "#/$defs/path"
        },
        "service": {
          "description": "Service file location",
          "$ref": "#/$defs/path"
        }
      }
    }
  }
}
